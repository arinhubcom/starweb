---
import type { HTMLAttributes } from "astro/types";

import type { IconName } from "@/lib/fonts";

import { iconClass } from "./icon-class";

type Props = Omit<HTMLAttributes<"span">, "children"> & {
  name: IconName;
  filled?: boolean;
};

const { name, filled = false, class: className, ...props } = Astro.props;
---

<span
  data-slot="material-icon"
  aria-hidden="true"
  translate="no"
  class={iconClass(filled, className)}
  {...props}
>
  {name}
</span>
