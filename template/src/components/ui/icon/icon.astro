---
import type { HTMLAttributes } from "astro/types";

import type { IconName } from "@/lib/fonts";
import { cn } from "@/lib/utils";

type Props = Omit<HTMLAttributes<"span">, "children"> & {
  name: IconName;
  filled?: boolean;
};

const { name, filled = false, class: className, ...props } = Astro.props;
---

<span
  data-slot="icon"
  aria-hidden="true"
  translate="no"
  class={cn("icon", filled && "icon-filled", className)}
  {...props}
>
  {name}
</span>
