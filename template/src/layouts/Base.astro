---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { Font } from "astro:assets";
import { MaterialIcon } from "@/components/ui/material-icon";
import { themeScript } from "@/lib/theme-script";
import "@/styles/global.css";

interface Props {
  title: string;
  pageTitle?: string | null;
  description?: string | null;
  image?: string | null;
  canonical?: string | null;
  /** Pass content reference for plugin page contributions on content pages */
  content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
  Astro.props;
const [settingsResult, menuResult] = await Promise.all([
  getSiteSettingsWithCacheHint(),
  getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
  Astro.cache.set(settingsResult.cacheHint);
  Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
  settingsResult.data,
);
const titleIncludesSiteName =
  title === siteTitle ||
  title.endsWith(` | ${siteTitle}`) ||
  title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

const pageCtx = createPublicPageContext({
  Astro: {
    url: Astro.url,
    ...(Astro.currentLocale ? { currentLocale: Astro.currentLocale } : {}),
  },
  kind: content ? "content" : "custom",
  pageType: "website",
  title: fullTitle,
  pageTitle: pageTitle ?? title,
  description: pageDescription,
  canonical: canonical ?? null,
  image: image ?? null,
  ...(content ? { content } : {}),
  siteName: siteTitle,
});
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <script is:inline set:html={themeScript} />
    <Font cssVariable="--font-roboto-flex" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-material-symbols" preload />
    <EmDashHead page={pageCtx} />
  </head>
  <body class="@container">
    <a href="#main" class="sr-only focus:not-sr-only">
      Skip to main content
    </a>
    <EmDashBodyStart page={pageCtx} />

    <header>
      <nav>
        <a href="/">
          {siteLogo ? (
            <img
              src={siteLogo.url}
              alt={siteLogo.alt || siteTitle}
              style="height:48px;width:auto;margin:-8px 0;display:block;"
            />
          ) : (
            siteTitle
          )}
        </a>
        {menu?.items.map((item) => (
          <a
            href={item.url}
            target={item.target}
            rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        ))}
        <MaterialIcon name="search" />
        <LiveSearch placeholder="Search..." collections={["posts", "pages"]} />
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <a href="/privacy">Privacy</a>
    </footer>

    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
