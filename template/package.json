{
  "name": "starweb-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/write-headers.ts && astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "test": "vitest run --coverage",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run knip && npm run test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@astrojs/react": "6.0.6",
    "@emdash-cms/cloudflare": "1.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "effect": "4.0.5",
    "emdash": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "zod-compiler": "2.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-plugin": "1.4.3",
    "@cloudflare/workers-types": "5.20261015.1",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-istanbul": "4.1.12",
    "create-emdash": "1.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.0"
  }
}
