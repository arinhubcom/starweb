{
  "name": "starweb-template",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Starter",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/write-headers.ts && tsx scripts/write-security-txt.ts && astro build && tsx scripts/check-built-fonts.ts",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "lint": "oxlint --type-aware --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "fonts": "tsx scripts/check-fonts.ts",
    "test": "vitest run --coverage",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run test",
    "size": "tsx scripts/check-js-size.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/react": "7.1.2",
    "@emdash-cms/cloudflare": "1.4.0",
    "@emdash-cms/plugin-field-kit": "0.1.2",
    "@emdash-cms/plugin-forms": "0.2.12",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "cn": "0.5.1",
    "effect": "4.1.1",
    "emdash": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.3",
    "zod": "catalog:",
    "zod-compiler": "2.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@cloudflare/vitest-plugin": "1.4.12",
    "@cloudflare/workers-types": "5.20261101.1",
    "@e18e/eslint-plugin": "0.8.1",
    "@material/material-color-utilities": "0.4.0",
    "@size-limit/file": "14.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "5.0.5",
    "es-module-lexer": "3.0.4",
    "knip": "6.44.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-react-doctor": "0.9.21",
    "oxlint-tsgolint": "7.0.2005",
    "parse5": "8.1.0",
    "shadcn": "4.23.0",
    "size-limit": "14.3.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
