{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__NAME__",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "placement": { "mode": "targeted", "region": "aws:eu-central-1" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__NAME__",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "__NAME__-media",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
    },
  ],
  // Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
  // "worker_loaders": [{ "binding": "LOADER" }],
  // General maintenance cron trigger
  "ratelimits": [
    {
      "name": "FORMS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
}
