// Test copy of wrangler.jsonc: only the bindings that tests need. No `main` (it
// fails with `Cannot find package 'virtual:astro-cloudflare:config'`), no `triggers`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__NAME__",
  "compatibility_date": "2026-08-04",
  "placement": { "mode": "targeted", "region": "aws:eu-central-1" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__NAME__",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "__NAME__-media",
    },
  ],
}
