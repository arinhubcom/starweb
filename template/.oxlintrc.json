{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vitest",
    "react",
    "jsx-a11y"
  ],
  "jsPlugins": [
    {
      "name": "react-doctor",
      "specifier": "oxlint-plugin-react-doctor"
    },
    {
      "name": "e18e",
      "specifier": "@e18e/eslint-plugin"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "settings": {
    "react-doctor": {
      "capabilities": [
        "base-ui",
        "react",
        "react:19",
        "react:19.2",
        "shadcn",
        "ssr",
        "tailwind",
        "tailwind:3.4",
        "tailwind:4",
        "zod:4"
      ]
    }
  },
  "ignorePatterns": [
    ".agents/",
    ".claude/",
    ".cursor/",
    "dist/",
    "coverage/",
    ".astro/",
    ".wrangler/",
    "worker-configuration.d.ts",
    "emdash-env.d.ts"
  ],
  "rules": {
    "typescript/no-unsafe-type-assertion": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-await-in-loop": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "class-variance-authority",
            "message": "Use tv() from tailwind-variants: rules/COMPONENTS.md."
          }
        ],
        "patterns": [
          {
            "group": ["lucide-react", "lucide-react/**", "@lucide/**"],
            "message": "Use the Material Symbols Icon component: rules/MEDIA.md."
          }
        ]
      }
    ],
    "oxc/no-map-spread": "off",
    "react/react-in-jsx-scope": "off",
    "unicorn/require-module-specifiers": "off",
    "e18e/ban-dependencies": "error",
    "e18e/prefer-array-at": "error",
    "e18e/prefer-array-fill": "error",
    "e18e/prefer-array-from-map": "error",
    "e18e/prefer-array-some": "error",
    "e18e/prefer-array-to-reversed": "error",
    "e18e/prefer-array-to-sorted": "error",
    "e18e/prefer-array-to-spliced": "error",
    "e18e/prefer-date-now": "error",
    "e18e/prefer-includes": "error",
    "e18e/prefer-nullish-coalescing": "error",
    "e18e/prefer-object-has-own": "error",
    "e18e/prefer-regex-test": "error",
    "e18e/prefer-spread-syntax": "error",
    "e18e/prefer-static-regex": "error",
    "e18e/prefer-timer-args": "error",
    "e18e/prefer-url-canparse": "error",
    "react-doctor/advanced-event-handler-refs": "warn",
    "react-doctor/anchor-target-exists": "warn",
    "react-doctor/async-await-in-loop": "warn",
    "react-doctor/async-defer-await": "warn",
    "react-doctor/async-parallel": "warn",
    "react-doctor/auth-token-in-web-storage": "warn",
    "react-doctor/base-ui-dialog-popup-requires-title": "warn",
    "react-doctor/base-ui-field-requires-label": "warn",
    "react-doctor/base-ui-tabs-tab-requires-list": "warn",
    "react-doctor/class-component-missing-component-will-unmount-teardown": "warn",
    "react-doctor/client-passive-event-listeners": "warn",
    "react-doctor/context-provider-value-from-unmemoized-local-literal": "warn",
    "react-doctor/debounce-no-cleanup": "warn",
    "react-doctor/dialog-has-accessible-name": "warn",
    "react-doctor/effect-listener-cleanup-mismatch": "error",
